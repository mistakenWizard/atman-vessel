# Rust build output.
target/
**/target/

# Local orchestrator runtime state, generated handoffs, locks, profiles, probes,
# crash recovery, archives, and isolated worktrees.
.orchestrator/
**/.orchestrator/
.worktrees/
**/.worktrees/

# EXPLICITLY ALLOW AGENTS TO READ THEIR SOUL (Internal State)
!/**/.orchestrator/HANDOFF.md
!/**/.orchestrator/session.json


# Generated local reports/state that can contain run-specific context.
src-rust/brain/post-mortems/

# Provider credentials and local auth caches must never be committed.
**/.gemini/
**/.codex/auth.json
**/.codex/config.toml
**/.codex/sessions/
**/.codex/history.jsonl

# Environment files and local overrides.
.env
.env.*
!.env.example
*.local
*.local.*

